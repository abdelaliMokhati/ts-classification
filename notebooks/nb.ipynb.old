   "source": [
    "from scipy import signal\n",
    "import matplotlib.pyplot as plt\n",
    "f, Pxx = signal.periodogram(s1, fs=1)\n",
    "\n",
    "# 3. Plot\n",
    "plt.figure()\n",
    "plt.semilogy(f, Pxx)\n",
    "plt.xlabel('Frequency [Hz]')\n",
    "plt.ylabel('PSD [V**2/Hz]')\n",
    "plt.title('Periodogram')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "aa9835ef",
   "metadata": {},
   "source": [
    "**Coment**: 0.25 hz <=> period = 4 -- Validated"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "8e0809ad",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1600x400 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "from statsmodels.tsa.seasonal import seasonal_decompose\n",
    "\n",
    "np.random.seed(42)\n",
    "s1 = train_x.iloc[np.random.randint(0, N), 0][:50]\n",
    "s2 = train_x.iloc[np.random.randint(0, N), 0][:50]\n",
    "s3 = train_x.iloc[np.random.randint(0, N), 0][:50]\n",
    "s_deseasonalised = []\n",
    "for s in [s1, s2, s3]:\n",
    "\n",
    "    seasonal_result = seasonal_decompose(s, period=4)\n",
    "    seasonal = seasonal_result.seasonal\n",
    "    s_deseasonalised.append(s - seasonal)\n",
    "\n",
    "_ = plot_series(*s_deseasonalised, title=\"deseasonalised(s)\", labels=[f\"s{i+1}\" for i in range(3)])"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "99685605",
   "metadata": {},
   "source": [
    "### Analyze residuals"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "05013b6e",
   "metadata": {},
   "outputs": [
