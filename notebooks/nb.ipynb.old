   ],
   "source": [
    "from sktime.utils import plot_series\n",
    "\n",
    "# Extract the time series correctly (from the nested structure)\n",
    "s1 = train_x.iloc[0, 0][:100]\n",
    "s2 = train_x.iloc[3, 0][:100]\n",
    "s3 = train_x.iloc[18, 0][:100]\n",
    "\n",
    "\n",
    "# Only reset index if you want a clean integer index, but plot_series works with the Series as-is\n",
    "plot_series(s1, s2, s3)"
   ]
  },
