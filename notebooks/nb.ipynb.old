   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.gridspec as gridspec\n",
    "\n",
    "# ── 1. Extract kernels (same path as before) ──────────────────────────────────\n",
    "rocket       = clf.univar_rocket_.transformers_.steps_[0][1]\n",
    "all_weights, lengths, biases, dilations, paddings, num_ch, ch_idx = rocket.kernels\n",
    "weights_list = np.split(all_weights, np.cumsum(lengths)[:-1])\n",
    "K            = len(lengths)\n",
    "\n",
    "# ── 2. Compute per-kernel summary stats ───────────────────────────────────────\n",
    "def kernel_stats(series, w, bias, dilation):\n",
    "    span = (len(w) - 1) * dilation\n",
    "    fm   = np.array([\n",
    "        bias + sum(w[j] * series[i + j * dilation] for j in range(len(w)))\n",
    "        for i in range(len(series) - span)\n",
    "    ])\n",
    "    return fm.max(), (fm > 0).mean()   # max, PPV\n",
    "\n",
    "# run all kernels on the first training sample\n",
    "ts      = train_X[0, 0, :]\n",
    "results = [kernel_stats(ts, weights_list[k], float(biases[k]), int(dilations[k]))\n",
    "           for k in range(K)]\n",
    "\n",
    "max_vals = np.array([r[0] for r in results])\n",
    "ppv_vals = np.array([r[1] for r in results])\n",
    "\n",
    "# ── 3. Summary table (printed) ────────────────────────────────────────────────\n",
    "print(f\"{'Kernel':>7} {'Length':>7} {'Dilation':>9} {'Bias':>8} \"\n",
    "      f\"{'Max':>8} {'PPV':>7} {'|w| mean':>9}\")\n",
    "print(\"─\" * 60)\n",
    "for k in range(K):\n",
    "    print(f\"{k:>7} {int(lengths[k]):>7} {int(dilations[k]):>9} \"\n",
    "          f\"{biases[k]:>8.3f} {max_vals[k]:>8.3f} \"\n",
    "          f\"{ppv_vals[k]:>7.1%} {np.abs(weights_list[k]).mean():>9.3f}\")\n",
    "\n",
    "print(\"─\" * 60)\n",
    "print(f\"{'mean':>7} {lengths.mean():>7.1f} {dilations.mean():>9.1f} \"\n",
    "      f\"{biases.mean():>8.3f} {max_vals.mean():>8.3f} \"\n",
    "      f\"{ppv_vals.mean():>7.1%} \"\n",
    "      f\"{np.mean([np.abs(w).mean() for w in weights_list]):>9.3f}\")\n",
    "\n",
    "# ── 4. Visualise ──────────────────────────────────────────────────────────────\n",
    "fig = plt.figure(figsize=(14, 11))\n",
    "fig.suptitle(f\"Kernel summary — all {K} kernels on sample #0 \"\n",
    "             f\"(class='{train_y[0]}')\", fontsize=13, fontweight=\"bold\")\n",
    "gs = gridspec.GridSpec(3, 3, figure=fig, hspace=0.55, wspace=0.35)\n",
    "\n",
    "# ── A: length distribution ────────────────────────────────────────────────────\n",
    "ax0 = fig.add_subplot(gs[0, 0])\n",
    "unique, counts = np.unique(lengths, return_counts=True)\n",
    "ax0.bar(unique.astype(str), counts, color=\"#185FA5\", width=0.5)\n",
    "ax0.set_title(\"A — kernel length distribution\")\n",
    "ax0.set_xlabel(\"length\")\n",
    "ax0.set_ylabel(\"count\")\n",
    "for u, c in zip(unique, counts):\n",
    "    ax0.text(str(u), c + 0.3, str(c), ha=\"center\", fontsize=9)\n",
    "\n",
    "# ── B: dilation distribution ──────────────────────────────────────────────────\n",
    "ax1 = fig.add_subplot(gs[0, 1])\n",
    "ax1.hist(dilations, bins=20, color=\"#534AB7\", edgecolor=\"white\", linewidth=0.5)\n",
    "ax1.set_title(\"B — dilation distribution\")\n",
    "ax1.set_xlabel(\"dilation\")\n",
    "ax1.set_ylabel(\"count\")\n",
    "\n",
    "# ── C: bias distribution ──────────────────────────────────────────────────────\n",
    "ax2 = fig.add_subplot(gs[0, 2])\n",
    "ax2.hist(biases, bins=20, color=\"#0F6E56\", edgecolor=\"white\", linewidth=0.5)\n",
    "ax2.axvline(0, color=\"gray\", lw=0.8, ls=\"--\")\n",
    "ax2.set_title(\"C — bias distribution\")\n",
    "ax2.set_xlabel(\"bias\")\n",
    "ax2.set_ylabel(\"count\")\n",
    "\n",
    "# ── D: PPV distribution ───────────────────────────────────────────────────────\n",
    "ax3 = fig.add_subplot(gs[1, 0])\n",
    "ax3.hist(ppv_vals, bins=20, color=\"#854F0B\", edgecolor=\"white\", linewidth=0.5)\n",
    "ax3.axvline(ppv_vals.mean(), color=\"orange\", lw=1.2, ls=\"--\",\n",
    "            label=f\"mean={ppv_vals.mean():.2f}\")\n",
    "ax3.set_title(\"D — PPV distribution (all kernels)\")\n",
    "ax3.set_xlabel(\"PPV\")\n",
    "ax3.set_ylabel(\"count\")\n",
    "ax3.legend(fontsize=9)\n",
    "\n",
    "# ── E: max distribution ───────────────────────────────────────────────────────\n",
    "ax4 = fig.add_subplot(gs[1, 1])\n",
    "ax4.hist(max_vals, bins=20, color=\"#A32D2D\", edgecolor=\"white\", linewidth=0.5)\n",
    "ax4.axvline(max_vals.mean(), color=\"orange\", lw=1.2, ls=\"--\",\n",
    "            label=f\"mean={max_vals.mean():.2f}\")\n",
    "ax4.set_title(\"E — max distribution (all kernels)\")\n",
    "ax4.set_xlabel(\"max activation\")\n",
    "ax4.set_ylabel(\"count\")\n",
    "ax4.legend(fontsize=9)\n",
    "\n",
    "# ── F: max vs PPV scatter ─────────────────────────────────────────────────────\n",
    "ax5 = fig.add_subplot(gs[1, 2])\n",
    "sc = ax5.scatter(max_vals, ppv_vals,\n",
    "                 c=dilations, cmap=\"plasma\", s=20, alpha=0.7)\n",
    "plt.colorbar(sc, ax=ax5, label=\"dilation\")\n",
    "ax5.set_title(\"F — max vs PPV (color = dilation)\")\n",
    "ax5.set_xlabel(\"max activation\")\n",
    "ax5.set_ylabel(\"PPV\")\n",
    "\n",
    "# ── G: mean |weight| per kernel ───────────────────────────────────────────────\n",
    "ax6 = fig.add_subplot(gs[2, :])\n",
    "mean_abs_w = np.array([np.abs(w).mean() for w in weights_list])\n",
    "# sort by mean |weight| descending for readability\n",
    "order       = np.argsort(mean_abs_w)[::-1]\n",
    "bar_colors  = plt.cm.plasma(dilations[order] / dilations.max())\n",
    "bars = ax6.bar(range(K), mean_abs_w[order], color=bar_colors, width=0.8)\n",
    "ax6.set_title(\"G — mean |weight| per kernel (sorted, color = dilation)\")\n",
    "ax6.set_xlabel(\"kernel rank\")\n",
    "ax6.set_ylabel(\"mean |weight|\")\n",
    "\n",
    "sm = plt.cm.ScalarMappable(cmap=\"plasma\",\n",
    "     norm=plt.Normalize(dilations.min(), dilations.max()))\n",
    "sm.set_array([])\n",
    "plt.colorbar(sm, ax=ax6, label=\"dilation\")\n",
    "\n",
    "plt.savefig(\"rocket_kernel_summary.png\", dpi=150, bbox_inches=\"tight\")\n",
    "plt.show()"
   ]
  },
