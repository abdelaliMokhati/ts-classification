    "from scipy import signal\n",
    "import matplotlib.pyplot as plt\n",
    "f, Pxx = signal.periodogram(s1, fs=1)\n",
    "\n",
    "# 3. Plot\n",
    "plt.figure()\n",
    "plt.semilogy(f, Pxx)\n",
    "plt.xlabel('Frequency [Hz]')\n",
    "plt.ylabel('PSD [V**2/Hz]')\n",
    "plt.title('Periodogram')\n",
    "plt.show()"
   ]
  },
