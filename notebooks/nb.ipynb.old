    "from sktime.forecasting.arima import AutoARIMA\n",
    "from sktime.forecasting.model_selection import temporal_train_test_split\n",
    "forecaster = AutoARIMA(sp=4, D=2)\n",
    "s_train, s_test = temporal_train_test_split(s, test_size=20)\n",
    "forecaster.fit(s_train)\n",
    "s_pred = forecaster.predict(fh=np.arange(1, 21))\n",
    "_ = plot_series(s_train, s_test, s_pred, labels=[\"train\", \"test\", \"pred\"], title=\"ARIMA Forecasting\")"
   ]
  },
