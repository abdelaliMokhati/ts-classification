   "source": [
    "from sktime.param_est.seasonality import SeasonalityACF\n",
    "\n",
    "# compute seasonality on first differences - to make the series stationary first\n",
    "sp_est =  SeasonalityACF()\n",
    "sp_est.fit(s_deseason1)\n",
    "\n",
    "sp_est.get_fitted_params()"
   ]
  },
