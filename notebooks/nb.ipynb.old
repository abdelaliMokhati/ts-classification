, 'get_param_defaults', 'get_param_names', 'get_params', 'get_tag', 'get_tags', 'get_test_params', 'is_composite', 'is_fitted', 'load_from_path', 'load_from_serial', 'max_dilations_per_kernel', 'multivar_rocket_', 'n_classes_', 'n_features_per_kernel', 'n_jobs', 'num_kernels', 'num_kernels_', 'predict', 'predict_proba', 'random_state', 'reset', 'rocket_transform', 'save', 'score', 'set_config', 'set_params', 'set_random_state', 'set_tags', 'univar_rocket_', 'use_multivariate']\n"
