   "source": [
    "from scipy import signal\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Compute periodograms for all mean series in one graph\n",
    "n_classes = len(mean_series)\n",
    "fig, axes = plt.subplots(2, 5, figsize=(20, 8))\n",
    "axes = axes.flatten()\n",
    "\n",
    "for idx, (label, series) in enumerate(mean_series.items()):\n",
    "    f, Pxx = signal.periodogram(series, fs=1)\n",
    "    axes[idx].semilogy(f, Pxx)\n",
    "    axes[idx].set_xlabel('Frequency [Hz]')\n",
    "    axes[idx].set_ylabel('PSD [V**2/Hz]')\n",
    "    axes[idx].set_title(f'Periodogram - Label {label}')\n",
    "    axes[idx].grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
