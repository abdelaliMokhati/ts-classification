    "# Visualization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e20eee14",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Kernels extracted: 100\n",
      "Dilation range   : 1 – 39\n"
     ]
    },
    {
     "data": {
      "image/png": "",
