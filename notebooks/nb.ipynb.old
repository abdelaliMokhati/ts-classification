   ],
   "source": [
    "s = s1\n",
    "s_deseason1 = s_deseasonalised[0]\n",
    "seasonal_result = seasonal_decompose(s_deseason1, period=4)\n",
    "seasonal = seasonal_result.seasonal\n",
    "s_deseason2 = s_deseason1 - seasonal\n",
    "_ = plot_series(s, s_deseason1, s_deseason2, title=\"Deseasonalised vs Deseasonalised again\", labels=[\"s\", \"Deseasonalised\", \"Deseasonalised 2\"])"
   ]
  },
