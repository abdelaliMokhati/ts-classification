      "\u001b[36mFile \u001b[39m\u001b[32m~/miniconda3/envs/TSAC/lib/python3.14/site-packages/sktime/clustering/partitioning/_lloyds.py:342\u001b[39m, in \u001b[36mBaseTimeSeriesLloyds._fit\u001b[39m\u001b[34m(self, X, y)\u001b[39m\n\u001b[32m    340\u001b[39m best_iters = \u001b[38;5;28mself\u001b[39m.max_iter\n\u001b[32m    341\u001b[39m \u001b[38;5;28;01mfor\u001b[39;00m _ \u001b[38;5;129;01min\u001b[39;00m \u001b[38;5;28mrange\u001b[39m(\u001b[38;5;28mself\u001b[39m.n_init):\n\u001b[32m--> \u001b[39m\u001b[32m342\u001b[39m     labels, centers, inertia, n_iters = \u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43m_fit_one_init\u001b[49m\u001b[43m(\u001b[49m\u001b[43mX\u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m    343\u001b[39m     \u001b[38;5;28;01mif\u001b[39;00m inertia < best_inertia:\n\u001b[32m    344\u001b[39m         best_centers = centers\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/miniconda3/envs/TSAC/lib/python3.14/site-packages/sktime/clustering/partitioning/_lloyds.py:434\u001b[39m, in \u001b[36mBaseTimeSeriesLloyds._fit_one_init\u001b[39m\u001b[34m(self, X)\u001b[39m\n\u001b[32m    431\u001b[39m     \u001b[38;5;28;01mif\u001b[39;00m \u001b[38;5;28mself\u001b[39m.verbose \u001b[38;5;129;01mis\u001b[39;00m \u001b[38;5;28;01mTrue\u001b[39;00m:\n\u001b[32m    432\u001b[39m         \u001b[38;5;28mprint\u001b[39m(\u001b[33mf\u001b[39m\u001b[33m\"\u001b[39m\u001b[33mIteration \u001b[39m\u001b[38;5;132;01m{\u001b[39;00mi\u001b[38;5;132;01m}\u001b[39;00m\u001b[33m, inertia \u001b[39m\u001b[38;5;132;01m{\u001b[39;00minertia\u001b[38;5;132;01m}\u001b[39;00m\u001b[33m.\u001b[39m\u001b[33m\"\u001b[39m)  \u001b[38;5;66;03m# noqa: T201\u001b[39;00m\n\u001b[32m--> \u001b[39m\u001b[32m434\u001b[39m labels, inertia = \u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43m_assign_clusters\u001b[49m\u001b[43m(\u001b[49m\u001b[43mX\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mcluster_centres\u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m    435\u001b[39m centres = cluster_centres\n\u001b[32m    437\u001b[39m \u001b[38;5;28;01mreturn\u001b[39;00m labels, centres, inertia, i + \u001b[32m1\u001b[39m\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/miniconda3/envs/TSAC/lib/python3.14/site-packages/sktime/clustering/partitioning/_lloyds.py:464\u001b[39m, in \u001b[36mBaseTimeSeriesLloyds._assign_clusters\u001b[39m\u001b[34m(self, X, cluster_centres)\u001b[39m\n\u001b[32m    439\u001b[39m \u001b[38;5;28;01mdef\u001b[39;00m\u001b[38;5;250m \u001b[39m\u001b[34m_assign_clusters\u001b[39m(\n\u001b[32m    440\u001b[39m     \u001b[38;5;28mself\u001b[39m, X: np.ndarray, cluster_centres: np.ndarray\n\u001b[32m    441\u001b[39m ) -> \u001b[38;5;28mtuple\u001b[39m[np.ndarray, \u001b[38;5;28mfloat\u001b[39m]:\n\u001b[32m    442\u001b[39m \u001b[38;5;250m    \u001b[39m\u001b[33;03m\"\"\"Assign each instance to a cluster.\u001b[39;00m\n\u001b[32m    443\u001b[39m \n\u001b[32m    444\u001b[39m \u001b[33;03m    This is done by computing the distance between each instance and\u001b[39;00m\n\u001b[32m   (...)\u001b[39m\u001b[32m    462\u001b[39m \u001b[33;03m        the assigned clusters.\u001b[39;00m\n\u001b[32m    463\u001b[39m \u001b[33;03m    \"\"\"\u001b[39;00m\n\u001b[32m--> \u001b[39m\u001b[32m464\u001b[39m     pairwise = \u001b[43mpairwise_distance\u001b[49m\u001b[43m(\u001b[49m\n\u001b[32m    465\u001b[39m \u001b[43m        \u001b[49m\u001b[43mX\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mcluster_centres\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mmetric\u001b[49m\u001b[43m=\u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mmetric\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43m*\u001b[49m\u001b[43m*\u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43m_distance_params\u001b[49m\n\u001b[32m    466\u001b[39m \u001b[43m    \u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m    467\u001b[39m     \u001b[38;5;28;01mreturn\u001b[39;00m pairwise.argmin(axis=\u001b[32m1\u001b[39m), pairwise.min(axis=\u001b[32m1\u001b[39m).sum()\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/miniconda3/envs/TSAC/lib/python3.14/site-packages/sktime/distances/_distance.py:2153\u001b[39m, in \u001b[36mpairwise_distance\u001b[39m\u001b[34m(x, y, metric, **kwargs)\u001b[39m\n\u001b[32m   2149\u001b[39m symmetric = np.array_equal(_x, _y)\n\u001b[32m   2150\u001b[39m _metric_callable = _resolve_metric_to_factory(\n\u001b[32m   2151\u001b[39m     metric, _x[\u001b[32m0\u001b[39m], _y[\u001b[32m0\u001b[39m], _METRIC_INFOS, **kwargs\n\u001b[32m   2152\u001b[39m )\n\u001b[32m-> \u001b[39m\u001b[32m2153\u001b[39m \u001b[38;5;28;01mreturn\u001b[39;00m \u001b[43m_compute_pairwise_distance\u001b[49m\u001b[43m(\u001b[49m\u001b[43m_x\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43m_y\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43msymmetric\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43m_metric_callable\u001b[49m\u001b[43m)\u001b[49m\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/miniconda3/envs/TSAC/lib/python3.14/site-packages/sktime/distances/_numba_utils.py:87\u001b[39m, in \u001b[36m_compute_pairwise_distance\u001b[39m\u001b[34m(x, y, symmetric, distance_callable)\u001b[39m\n\u001b[32m     85\u001b[39m             pairwise_matrix[i, j] = pairwise_matrix[j, i]\n\u001b[32m     86\u001b[39m         \u001b[38;5;28;01melse\u001b[39;00m:\n\u001b[32m---> \u001b[39m\u001b[32m87\u001b[39m             pairwise_matrix[i, j] = \u001b[43mdistance_callable\u001b[49m\u001b[43m(\u001b[49m\u001b[43mcurr_x\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43m_y\u001b[49m\u001b[43m[\u001b[49m\u001b[43mj\u001b[49m\u001b[43m]\u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m     88\u001b[39m \u001b[38;5;28;01mreturn\u001b[39;00m pairwise_matrix\n",
      "\u001b[31mKeyboardInterrupt\u001b[39m: "
     ]
    }
   ],
   "source": [
    "from sktime.clustering.k_means import TimeSeriesKMeans\n",
    "clusterer = TimeSeriesKMeans(n_clusters=3)\n",
    "y_pred = clusterer.fit_predict(train_x)\n",
    "print(\"Cluster assignments:\", y_pred)"
   ]
