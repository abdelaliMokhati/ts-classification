       "<Figure size 1400x1000 with 4 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.gridspec as gridspec\n",
    "from matplotlib.patches import Patch\n",
    "\n",
    "# ── 1. Fit the classifier (skip if already done) ──────────────────────────────\n",
    "from sktime.datasets import load_arrow_head\n",
    "from sktime.classification.kernel_based import RocketClassifier\n",
    "\n",
    "train_X, train_y = load_arrow_head(split=\"train\", return_type=\"numpy3d\")\n",
    "clf = RocketClassifier(num_kernels=100)\n",
    "clf.fit(train_X, train_y)\n",
    "\n",
    "# ── 2. Extract kernels from the fitted clf ────────────────────────────────────\n",
    "# path: clf → univar_rocket_ (SklearnClassifierPipeline)\n",
    "#           → transformers_  (TransformerPipeline)\n",
    "#           → steps_[0][1]   (fitted Rocket transformer)\n",
    "rocket = clf.univar_rocket_.transformers_.steps_[0][1]\n",
    "\n",
    "# kernels is a tuple of 7 arrays:\n",
    "# [0] all_weights : (sum of kernel lengths,)  — all weights concatenated\n",
    "# [1] lengths     : (K,)\n",
    "# [2] biases      : (K,)\n",
    "# [3] dilations   : (K,)\n",
    "# [4] paddings    : (K,)\n",
    "# [5] num_ch      : (K,)\n",
    "# [6] ch_idx      : (K,)\n",
    "all_weights, lengths, biases, dilations, paddings, num_ch, ch_idx = rocket.kernels\n",
    "\n",
    "# split concatenated weights back into per-kernel arrays\n",
    "weights_list = np.split(all_weights, np.cumsum(lengths)[:-1])\n",
    "K_actual     = len(lengths)\n",
    "\n",
    "print(f\"Kernels extracted: {K_actual}\")\n",
    "print(f\"Dilation range   : {dilations.min()} – {dilations.max()}\")\n",
    "\n",
    "# ── 3. Pick one real sample and one kernel to spotlight ───────────────────────\n",
    "SAMPLE_IDX = 0\n",
    "KERNEL_IDX = 2\n",
    "\n",
    "ts       = train_X[SAMPLE_IDX, 0, :]       # shape: (n_timepoints,)\n",
    "N        = len(ts)\n",
    "kernel_w = weights_list[KERNEL_IDX]\n",
    "kernel_b = float(biases[KERNEL_IDX])\n",
    "dilation = int(dilations[KERNEL_IDX])\n",
    "klen     = int(lengths[KERNEL_IDX])\n",
    "\n",
    "# ── 4. Convolve helper ────────────────────────────────────────────────────────\n",
    "def convolve(series, w, bias, dilation):\n",
    "    span = (len(w) - 1) * dilation\n",
    "    out  = []\n",
    "    for i in range(len(series) - span):\n",
    "        val = bias + sum(w[j] * series[i + j * dilation] for j in range(len(w)))\n",
    "        out.append(val)\n",
    "    return np.array(out)\n",
    "\n",
    "fm      = convolve(ts, kernel_w, kernel_b, dilation)\n",
    "max_val = fm.max()\n",
    "ppv     = (fm > 0).mean()\n",
    "\n",
    "# ── 5. Full feature vector via the transformer ────────────────────────────────\n",
    "# use the whole transformers_ pipeline (Rocket + StandardScaler)\n",
    "feature_vector = clf.univar_rocket_.transformers_.transform(\n",
    "    train_X[[SAMPLE_IDX]]\n",
    ")\n",
    "# shape: (2 * K_actual,) — alternating [max_0, ppv_0, max_1, ppv_1, ...]\n",
    "\n",
    "K_plot = min(K_actual, 20)      # cap panel D at 20 kernels for readability\n",
    "\n",
    "# ── 6. Visualise ──────────────────────────────────────────────────────────────\n",
    "fig = plt.figure(figsize=(14, 10))\n",
    "fig.suptitle(\n",
    "    f\"ROCKET internals — sample #{SAMPLE_IDX} (class='{train_y[SAMPLE_IDX]}'), \"\n",
    "    f\"kernel {KERNEL_IDX} spotlighted\",\n",
    "    fontsize=13, fontweight=\"bold\"\n",
    ")\n",
    "gs = gridspec.GridSpec(3, 2, figure=fig, hspace=0.5, wspace=0.35)\n",
    "\n",
    "start = max(0, (N - (klen - 1) * dilation - 1) // 2)\n",
    "\n",
    "# Panel A — time series + kernel overlay\n",
    "ax0 = fig.add_subplot(gs[0, :])\n",
    "ax0.plot(ts, color=\"#185FA5\", lw=1.5, label=f\"series (class={train_y[SAMPLE_IDX]})\")\n",
    "ax0.axhline(0, color=\"gray\", lw=0.5, ls=\"--\")\n",
    "\n",
    "dot_indices = [start + j * dilation for j in range(klen) if start + j * dilation < N]\n",
    "colors      = [\"#0F6E56\" if w > 0 else \"#A32D2D\" for w in kernel_w[:len(dot_indices)]]\n",
    "for idx, c, w in zip(dot_indices, colors, kernel_w):\n",
    "    ax0.scatter(idx, ts[idx], color=c, s=80, zorder=5)\n",
    "    ax0.annotate(f\"{w:.2f}\", (idx, ts[idx]),\n",
    "                 textcoords=\"offset points\", xytext=(0, 8),\n",
    "                 ha=\"center\", fontsize=7, color=c)\n",
    "\n",
    "ax0.set_title(f\"Panel A — time series + kernel {KERNEL_IDX} \"\n",
    "              f\"(len={klen}, dilation={dilation}, bias={kernel_b:.3f})\")\n",
    "ax0.set_xlabel(\"time step\")\n",
    "ax0.legend(fontsize=9)\n",
    "\n",
    "# Panel B — kernel weights\n",
    "ax1 = fig.add_subplot(gs[1, 0])\n",
    "ax1.bar(range(klen), kernel_w,\n",
    "        color=[\"#0F6E56\" if w > 0 else \"#A32D2D\" for w in kernel_w])\n",
    "ax1.axhline(0, color=\"gray\", lw=0.5)\n",
    "ax1.set_title(f\"Panel B — kernel {KERNEL_IDX} weights\\n(bias={kernel_b:.3f})\")\n",
    "ax1.set_xlabel(\"kernel position\")\n",
    "ax1.set_ylabel(\"weight\")\n",
    "\n",
    "# Panel C — feature map\n",
    "ax2 = fig.add_subplot(gs[1, 1])\n",
    "ax2.plot(fm, color=\"#185FA5\", lw=1.2)\n",
    "ax2.fill_between(range(len(fm)), fm, 0,\n",
    "                 where=(fm > 0), alpha=0.25, color=\"#0F6E56\", label=\"positive (PPV)\")\n",
    "ax2.fill_between(range(len(fm)), fm, 0,\n",
    "                 where=(fm < 0), alpha=0.25, color=\"#A32D2D\", label=\"negative\")\n",
    "ax2.axhline(0,       color=\"gray\",   lw=0.5, ls=\"--\")\n",
    "ax2.axhline(max_val, color=\"orange\", lw=1,   ls=\":\", label=f\"max={max_val:.3f}\")\n",
    "ax2.set_title(f\"Panel C — feature map\\nmax={max_val:.3f}  |  PPV={ppv*100:.1f}%\")\n",
    "ax2.set_xlabel(\"position\")\n",
    "ax2.legend(fontsize=8)\n",
    "\n",
    "# Panel D — first K_plot kernels of the feature vector\n",
    "ax3 = fig.add_subplot(gs[2, :])\n",
    "fv_plot = feature_vector[:K_plot * 2]\n",
    "labels  = [f\"k{i}\\n{'max' if j==0 else 'PPV'}\"\n",
    "           for i in range(K_plot) for j in range(2)]\n",
    "fcolors = [\"#0F6E56\" if i % 2 == 0 else \"#534AB7\" for i in range(len(fv_plot))]\n",
    "bars    = ax3.bar(range(len(fv_plot)), fv_plot, color=fcolors, width=0.7)\n",
    "\n",
    "for j in [KERNEL_IDX * 2, KERNEL_IDX * 2 + 1]:\n",
    "    if j < len(bars):\n",
    "        bars[j].set_edgecolor(\"orange\")\n",
    "        bars[j].set_linewidth(2)\n",
    "\n",
    "ax3.set_xticks(range(len(labels)))\n",
    "ax3.set_xticklabels(labels, fontsize=7)\n",
    "ax3.axhline(0, color=\"gray\", lw=0.5)\n",
    "ax3.set_title(f\"Panel D — first {K_plot} kernels × 2 features \"\n",
    "              f\"(of {K_actual} total) — orange outline = kernel {KERNEL_IDX}\")\n",
    "ax3.set_ylabel(\"feature value\")\n",
    "ax3.legend(handles=[Patch(color=\"#0F6E56\", label=\"max\"),\n",
    "                    Patch(color=\"#534AB7\", label=\"PPV\")],\n",
    "           fontsize=9, loc=\"upper right\")\n",
    "\n",
    "plt.savefig(\"rocket_visualisation.png\", dpi=150, bbox_inches=\"tight\")\n",
    "plt.show()"
   ]
  },
